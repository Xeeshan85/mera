#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#
# Important for running on CI or when gradle-wrapper.jar is missing:
#   The wrapper JAR will be auto-generated by Android Studio on first sync.
#   If running from CLI without the JAR, install Gradle 8.9 and run:
#     gradle wrapper --gradle-version 8.9
#

# Attempt to set APP_HOME
APP_HOME=$( cd "${APP_HOME:-./}" > /dev/null && pwd -P ) || exit

# Add default JVM options here
DEFAULT_JVM_OPTS="-Xmx2048m -Xms256m"

# Determine the Java command to use
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

# Resolve the wrapper JAR
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -e "$WRAPPER_JAR" ]; then
    echo ""
    echo "ERROR: gradle-wrapper.jar not found."
    echo ""
    echo "Please open this project in Android Studio — it will auto-generate the wrapper."
    echo "Or run: gradle wrapper --gradle-version 8.9"
    echo ""
    exit 1
fi

exec "$JAVACMD" \
    $DEFAULT_JVM_OPTS \
    -classpath "$WRAPPER_JAR" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
